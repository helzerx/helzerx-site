[Unit]
Description=ArveX Real Payment, Discord Ticket and Pterodactyl Automation
After=network-online.target arvex-api.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/arvex
EnvironmentFile=/var/www/arvex/.env
EnvironmentFile=-/var/www/arvex/.env.automation
ExecStart=/usr/bin/node /var/www/arvex/automation/index.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/arvex/data/automation

[Install]
WantedBy=multi-user.target
