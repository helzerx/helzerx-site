[Unit]
Description=HelzerX Discord and Pterodactyl Automation
After=network-online.target arvex-api.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/helzerx
EnvironmentFile=/var/www/helzerx/.env
EnvironmentFile=-/var/www/helzerx/.env.automation
ExecStart=/usr/bin/node /var/www/helzerx/automation/index.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/helzerx/data/automation

[Install]
WantedBy=multi-user.target
